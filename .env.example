# Copy to .env. Every value has a working default: with no .env at all the whole
# product still runs end to end — file-backed storage, and a deterministic mock
# in place of the model. Credentials change quality and durability, never the
# shape of the flow.
#
# NEVER commit a filled-in copy of this file. Nothing here reaches the browser:
# both frontends talk to this server, and the server holds the keys.

# --- Durable stores -------------------------------------------------------
# Both optional today. The repositories in services/data are file-backed and the
# session store is on disk; these are read so the wiring has one home when the
# durable store lands.
DATABASE_URL=
REDIS_URL=

# --- AI provider ----------------------------------------------------------
# OpenRouter by default. The gateway speaks the OpenAI-compatible chat API, so
# OpenAI, an Azure proxy or a local vLLM work by changing the base URL.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on OpenRouter's dashboard.
OPENROUTER_APP_NAME=Tara AI Interview
OPENROUTER_APP_URL=

# --- Voice transport ------------------------------------------------------
# Retell is the mouth and ears only. It never holds interview state.
RETELL_API_KEY=
RETELL_AGENT_ID=

# --- Runtime --------------------------------------------------------------
REJOIN_WINDOW_SEC=3600
# false = authored probe banks only. Tara still follows up; the follow-ups just
# stop adapting to what the candidate actually said.
LLM_PROBES_ENABLED=true

# --- Models, per workload -------------------------------------------------
# Deliberately NOT decided yet. Classifying a turn while a candidate waits is a
# different job from designing an interview from a JD, so each workload gets its
# own knob and we benchmark before choosing. Leave blank to fall back to
# TARA_MODEL_DEFAULT.
TARA_MODEL_DEFAULT=openai/gpt-4.1-mini

INTERVIEW_DESIGNER_MODEL=
QUESTION_GENERATOR_MODEL=
ANSWER_CLASSIFIER_MODEL=
FOLLOWUP_GENERATOR_MODEL=
SCORING_MODEL=
REPORT_GENERATOR_MODEL=

# --- Security -------------------------------------------------------------
# The recruiter API requires an authenticated session in EVERY deployment; none
# of the settings below turn that off. What they do is set the posture around it.

# `development` (default), or `production`/`staging`. Production turns on the
# checks that would be obstructive on a laptop: it refuses `*` origins, requires
# Secure cookies, requires at least one account to exist, and serves neither the
# `demo` invitation nor the demo answer overlay.
TARA_ENV=development

# Refuse to serve the recruiter API at all when authentication cannot work —
# no accounts exist. On for any non-local deployment: the alternative is a
# window where the only thing between the internet and every transcript is that
# nobody has signed up yet.
RECRUITER_AUTH_REQUIRED=false

# Session cookies carry `Secure` unless this is plain-HTTP local development.
# A Secure cookie is not sent over http://localhost, so a fresh clone would be
# unable to sign in if this defaulted on. Defaults to on when TARA_ENV is
# production or staging.
TARA_COOKIES_SECURE=

# The first administrator, for a deployment with no users yet. Read once at
# startup and never stored — only the scrypt hash of the password persists, and
# nothing prints it. Leave unset and create the first user interactively with
# `python -m tools.make_user --email you@example.com --admin`, which reads the
# password from a prompt rather than from a command line.
TARA_BOOTSTRAP_EMAIL=
TARA_BOOTSTRAP_PASSWORD=
TARA_BOOTSTRAP_ORG=

# Comma-separated origins, or * for local development. Production refuses `*`:
# with credentialed cookies, a wildcard origin is the whole browser-side
# defence given away.
ALLOWED_ORIGINS=*

# --- Deployment identity and logging --------------------------------------
# What is running, so a health check and a log line can name the build. A git
# sha, a tag, a build number. "dev" when nobody says.
TARA_VERSION=
# `json` for anything that ships logs; `text` for a terminal.
TARA_LOG_FORMAT=json
TARA_LOG_LEVEL=INFO
# The public addresses, used to build candidate links and to state in one place
# where this deployment actually lives.
# Serve the well-known `demo` invitation on a publicly reachable host. Off by
# default: `demo` never expires and anyone can guess it, so on a public URL it
# is an open door into a real interview — provider credit and voice minutes on
# every turn. A local host serves it regardless, so a fresh clone still works.
TARA_DEMO_INVITE=

TARA_PUBLIC_URL=
TARA_RECRUITER_URL=

# --- Data retention -------------------------------------------------------
# Pilot defaults, and they are choices rather than requirements — nothing in the
# product specification names a duration. See DATA_LIFECYCLE.md §3. A value of 0
# or an unparseable one falls back to the default rather than meaning "delete
# immediately". The transcript and evaluation periods are clamped to the
# candidate period: neither can outlive the record it belongs to.
CANDIDATE_DATA_RETENTION_DAYS=180
TRANSCRIPT_RETENTION_DAYS=90
EVALUATION_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=400
# Documentation for the operator, not a retention period: how often
# `python -m tools.retention_cleanup` is expected to run. Nothing schedules it.
RETENTION_SWEEP_INTERVAL_HOURS=24

# --- Interview defaults (a published version overrides all of these) ------
TARA_ROLE=customer_support_rep
TARA_QUESTION_BUDGET=8
TARA_MAX_PROBES=2
TARA_MAX_REASKS=2
TARA_MAX_CLARIFIES=2
TARA_MIN_ANSWER_CHARS=12
TARA_EMPATHY=true
